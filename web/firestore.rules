rules_version = '2';

// ============================================================================
// Pairing-phase rules (feature #2), hardened after code review.
// Sign-in is required, and the pairing flow is constrained so a signed-in user
// cannot rewrite arbitrary accounts. Feature #4 ("strict couple-scoped rules")
// further locks down all couple subcollections (messages, moments, etc.).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles.
    match /users/{uid} {
      // Reads stay open to signed-in users (needed to resolve a partner).
      allow read: if request.auth != null;
      // You may only create your own profile document.
      allow create: if request.auth != null && request.auth.uid == uid;
      // You may fully edit your OWN doc; for ANY other doc you may only flip
      // `coupleId` from null -> value (the pairing link), nothing else.
      allow update: if request.auth != null && (
        request.auth.uid == uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId'])
          && resource.data.coupleId == null
        )
      );
    }

    // Invite-code -> uid lookup. A code may only ever map to its creator.
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // Couple records — only a member may create/read/update one.
    match /couples/{coupleId} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.members;
    }
  }
}
