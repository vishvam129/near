# Firebase config — copy this file to ".env" and paste your own values.
# Get these from: Firebase console -> Project settings -> "Your apps" -> Web app -> SDK setup.
# The app runs without these, but sign-in stays disabled until they're filled in.
VITE_FIREBASE_API_KEY="paste-your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:abc123"
